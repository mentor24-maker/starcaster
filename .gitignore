.vercel

# Environment files — never commit secrets
.env
.env.*
!.env.example

# Local JSON stores that hold credentials or user data
data/api_settings.json
data/auth_users.json
data/auth_sessions.json

# Local-only files
docs/archives/
files/google_console_oauth_client_secret_*.json
starcaster-cookies.txt
