# Build artifacts — generated by `npm run build`; never commit.
# Vercel and CI rebuild these from source on every deploy.
public/app-shell.html
public/privacy-policy.html
public/terms-of-service.html
public/data-deletion.html
public/styles.css
public/bundle.js
public/builder-bundle.js
public/js/richtext-vendor.js
lib/builder/template.js
lib/builder/email-template.js
lib/builder/template-frame.js
lib/builder/email-render.js
lib/build-stamp.json
lib/site-import/dist/

# Claude Code: settings.json and skills are shared; everything else is personal
.claude/*
!.claude/settings.json
!.claude/skills/
docs/SQL/backups/

# Supabase CLI local state — machine-specific, not project source
supabase/.branches/
supabase/.temp/

# Screenshots from `npm run check:screens` — local artifacts, never committed
.ui-check/
