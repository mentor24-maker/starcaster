#!/bin/sh
# 1. Rebuild the hash-pinned artifacts so ?v= pins are a function of the
#    SOURCE, not of whatever stale bundle happens to be sitting in public/.
#    Without this, editing src/css/* and committing without a rebuild pins
#    the previous hash — the new CSS deploys but returning visitors keep the
#    cached old one. (That is exactly how PR #24 shipped a dead pin.)
# 2. Check the rebuilt bundles reference only in-repo paths, BEFORE pinning
#    them. A folder whose node_modules is a symlink elsewhere builds bytes
#    nobody else can reproduce, so the pin it writes is one CI will reject
#    on files your change never touched (PR #149).
# 3. Auto-pin ?v= content hashes on all HTML shells.
# 4. Parse every hand-written browser JS file. Nothing else in the toolchain
#    reads public/js/, so without this a syntax error is only discovered by a
#    user's browser — and it kills the whole file, not just that line.
# 5. Run repo convention checks (stale artifacts, public/js freeze, etc.)
#    on the staged diff.
#
# Note: the rebuild uses your WORKING TREE source. If you are committing only
# part of your edits, the pin reflects everything on disk — CI re-checks pins
# against a clean build of the merged branch and will flag any mismatch.
#
# Bypass conventions only with SKIP_CONVENTIONS=1 and a stated reason.
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Refuse to commit on main — it auto-deploys to production, and work belongs in
# a worktree. This is the guarantee behind the (best-effort) PreToolUse checks:
# every path to a change ends in a commit, and this catches all of them,
# whichever tool wrote the files. Override for a deliberate one-off with
# ALLOW_MAIN_EDITS=1 (say so and why).
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
if [ "$BRANCH" = "main" ] && [ "$ALLOW_MAIN_EDITS" != "1" ]; then
  echo "BLOCKED: refusing to commit on main — it auto-deploys to production." >&2
  echo "Move this work onto its own branch (nothing is lost):" >&2
  echo "  git stash            # set your changes aside" >&2
  echo "  npm run thread <topic>   # new worktree + branch off origin/main" >&2
  echo "  cd .claude/worktrees/<topic> && git stash pop   # bring them over" >&2
  echo "(Deliberate one-off: prefix with ALLOW_MAIN_EDITS=1 and say why.)" >&2
  exit 1
fi
node scripts/build_pinned_assets.mjs
node scripts/check_build_paths.cjs --quiet
node scripts/pin_asset_versions.cjs --stage
node scripts/check_syntax.cjs --quiet
node scripts/check_conventions.cjs
